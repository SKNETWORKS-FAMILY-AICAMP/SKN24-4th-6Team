# Django
DJANGO_SECRET_KEY=change-me-use-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
# SSL 발급 전 HTTP 운영에서는 둘 다 False 로 둬서 브라우저가 세션 쿠키를 저장할 수 있게 함.
# 인증서 발급 후 둘 다 키(또는 변수 자체 제거)로 다시 켤 것.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False


# aigo-ai (FastAPI RAG service) base URL - chat proxy posts here.
AIGO_AI_BASE_URL=aigo-ai-fastapi-service-url
AIGO_AI_INTERNAL_API_KEY=aigo-ai-internal-api-key
AIGO_AI_REQUEST_TIMEOUT=120

# PostgreSQL - 로컬은 SQLite 사용하므로 비워둠
DB_NAME=aigo_web
DB_USER=aigo
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Gmail SMTP — 로컬은 콘솔 출력이므로 비워둠
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
