DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-use-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_STATIC_ROOT=staticfiles
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_LANGUAGE_CODE=ko-kr

# Database URL.
#   Local sqlite fallback (dev only): sqlite:///db.sqlite3
#   Postgres (psycopg 3): postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=postgresql+psycopg://aigo:aigo@localhost:5432/aigo_web

# JWT signing key — falls back to DJANGO_SECRET_KEY when unset.
# Rotate this independently to invalidate all outstanding tokens.
DJANGO_JWT_SIGNING_KEY=

# aigo-ai (FastAPI RAG service) base URL — chat proxy posts here.
AIGO_AI_BASE_URL=http://localhost:8000